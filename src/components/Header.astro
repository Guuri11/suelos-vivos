---
import { siteConfig } from '@/config/site';
import { localePath, stripLangPrefix, t, LANG_NAMES, SUPPORTED_LANGS, type Lang } from '@/i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const lp = (path: string) => localePath(lang, path);

// Misma página en los otros idiomas. Enlaces reales, no un <select> con JS:
// si el rastreador no puede seguirlos, /en/ y /fr/ vuelven a ser huérfanas.
const basePath = stripLangPrefix(Astro.url.pathname);
const langLinks = SUPPORTED_LANGS.map((l) => ({
  lang: l,
  name: LANG_NAMES[l],
  href: localePath(l, basePath),
  current: l === lang,
}));
---

<header class="site-header fixed top-0 left-0 right-0 z-50 bg-[#FAFAF7]/95 backdrop-blur-sm border-b border-[#DDD8CE]">
  <div class="container">
    <nav class="flex items-center justify-between h-16 md:h-18">
      <!-- Logo -->
      <a href={lp('/')} class="flex items-center gap-2 shrink-0" aria-label="Suelos Vivos — inicio">
        <img
          src={siteConfig.logo.src}
          alt={siteConfig.logo.alt}
          width={siteConfig.logo.width}
          height={siteConfig.logo.height}
          class="h-9 w-auto"
          loading="eager"
        />
      </a>

      <!-- Nav desktop -->
      <ul class="hidden md:flex items-center gap-8 text-sm font-medium text-[#1E1A15]">
        <li><a href={lp('/')} class="hover:text-[#8B1A1A] transition-colors duration-200">{t(lang, 'nav.inicio')}</a></li>
        <li><a href={lp('/el-programa')} class="hover:text-[#8B1A1A] transition-colors duration-200">{t(lang, 'nav.elPrograma')}</a></li>
        <li><a href={lp('/servicios')} class="hover:text-[#8B1A1A] transition-colors duration-200">{t(lang, 'nav.servicios')}</a></li>
        <li><a href={lp('/quienes-somos')} class="hover:text-[#8B1A1A] transition-colors duration-200">{t(lang, 'nav.quienesSomos')}</a></li>
        <li><a href={lp('/blog')} class="hover:text-[#8B1A1A] transition-colors duration-200">{t(lang, 'nav.blog')}</a></li>
        <li><a href={lp('/contacto')} class="hover:text-[#8B1A1A] transition-colors duration-200">{t(lang, 'nav.contacto')}</a></li>
      </ul>

      <!-- CTA + hamburger -->
      <div class="flex items-center gap-3">
        <!-- Selector de idioma (desktop) -->
        <ul class="hidden md:flex items-center gap-1 text-xs font-medium" aria-label={t(lang, 'nav.idioma')}>
          {langLinks.map(({ lang: l, name, href, current }) => (
            <li>
              <a
                href={href}
                hreflang={l}
                lang={l}
                aria-current={current ? 'true' : undefined}
                class:list={[
                  'block px-1.5 py-1 uppercase tracking-wide transition-colors duration-200',
                  current ? 'text-[#8B1A1A]' : 'text-[#1E1A15]/45 hover:text-[#8B1A1A]',
                ]}
              >
                <span class="sr-only">{name}</span>
                <span aria-hidden="true">{l}</span>
              </a>
            </li>
          ))}
        </ul>

        <span class="hidden md:block w-px h-4 bg-[#DDD8CE]" aria-hidden="true"></span>

        <a
          href={lp('/reserva-plaza')}
          class="hidden md:inline-flex items-center px-4 py-2 bg-[#8B1A1A] text-[#FAFAF7] text-sm font-semibold rounded-md hover:bg-[#6B1212] transition-colors duration-200 cursor-pointer"
        >
          {t(lang, 'nav.reservarPlaza')}
        </a>

        <!-- Mobile hamburger -->
        <button
          id="menu-toggle"
          class="md:hidden p-2 rounded-md text-[#1E1A15] hover:bg-[#F0F2EE] transition-colors cursor-pointer"
          aria-label="Abrir menú"
          aria-expanded="false"
        >
          <svg id="icon-open" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
          <svg id="icon-close" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>
    </nav>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-[#DDD8CE] bg-[#FAFAF7]">
    <div class="container py-4 flex flex-col gap-4">
      <a href={lp('/')} class="text-sm font-medium text-[#1E1A15] hover:text-[#8B1A1A] transition-colors">{t(lang, 'nav.inicio')}</a>
      <a href={lp('/el-programa')} class="text-sm font-medium text-[#1E1A15] hover:text-[#8B1A1A] transition-colors">{t(lang, 'nav.elPrograma')}</a>
      <a href={lp('/servicios')} class="text-sm font-medium text-[#1E1A15] hover:text-[#8B1A1A] transition-colors">{t(lang, 'nav.servicios')}</a>
      <a href={lp('/quienes-somos')} class="text-sm font-medium text-[#1E1A15] hover:text-[#8B1A1A] transition-colors">{t(lang, 'nav.quienesSomos')}</a>
      <a href={lp('/blog')} class="text-sm font-medium text-[#1E1A15] hover:text-[#8B1A1A] transition-colors">{t(lang, 'nav.blog')}</a>
      <a href={lp('/contacto')} class="text-sm font-medium text-[#1E1A15] hover:text-[#8B1A1A] transition-colors">{t(lang, 'nav.contacto')}</a>
      <a href={lp('/reserva-plaza')} class="inline-flex justify-center items-center px-4 py-2.5 bg-[#8B1A1A] text-[#FAFAF7] text-sm font-semibold rounded-md hover:bg-[#6B1212] transition-colors cursor-pointer">
        {t(lang, 'nav.reservarPlaza')}
      </a>

      <!-- Selector de idioma (móvil) -->
      <ul class="flex items-center gap-4 pt-4 mt-1 border-t border-[#DDD8CE] text-sm font-medium" aria-label={t(lang, 'nav.idioma')}>
        {langLinks.map(({ lang: l, name, href, current }) => (
          <li>
            <a
              href={href}
              hreflang={l}
              lang={l}
              aria-current={current ? 'true' : undefined}
              class:list={[
                'transition-colors duration-200',
                current ? 'text-[#8B1A1A]' : 'text-[#1E1A15]/55 hover:text-[#8B1A1A]',
              ]}
            >
              {name}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector('.site-header') as HTMLElement;
  const toggle = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  // Mobile menu toggle
  toggle?.addEventListener('click', () => {
    const isOpen = !mobileMenu?.classList.contains('hidden');
    mobileMenu?.classList.toggle('hidden', isOpen);
    iconOpen?.classList.toggle('hidden', !isOpen);
    iconClose?.classList.toggle('hidden', isOpen);
    toggle.setAttribute('aria-expanded', String(!isOpen));
  });

  // Header hide/show on scroll
  let lastScrollY = 0;
  let rafId: number;

  window.addEventListener('scroll', () => {
    cancelAnimationFrame(rafId);
    rafId = requestAnimationFrame(() => {
      const currentY = window.scrollY;
      if (currentY > 100) {
        header?.classList.toggle('site-header--hidden', currentY > lastScrollY);
      } else {
        header?.classList.remove('site-header--hidden');
      }
      lastScrollY = currentY;
    });
  }, { passive: true });
</script>
