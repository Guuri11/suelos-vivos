---
import '@/styles/global.css';
import { siteConfig } from '@/config/site';
import CookieConsent from '@/components/CookieConsent.astro';
import { getLang, hreflangLinks, stripLangPrefix } from '@/i18n/utils';

interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title,
  description = siteConfig.description,
  image = '/images/og-image.jpg',
  noindex = false,
} = Astro.props;

const lang = getLang(Astro.currentLocale);
const basePath = stripLangPrefix(Astro.url.pathname);
const alternates = hreflangLinks(siteConfig.url, basePath);
const canonical = new URL(Astro.url.pathname, siteConfig.url).href;
const ogImage = new URL(image, siteConfig.url).href;
const ogLocale = lang === 'fr' ? 'fr_FR' : lang === 'en' ? 'en_GB' : 'es_ES';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- hreflang alternates -->
    {alternates.map(({ lang: hLang, href }) => (
      <link rel="alternate" hreflang={hLang} href={href} />
    ))}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={ogLocale} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Schema.org Course -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Course",
        "name": "Suelos Vivos — Programa de Agricultura Regenerativa",
        "description": "Programa anual de formación en biofertilidad y agricultura regenerativa para agricultores profesionales. 3 talleres presenciales + 12 meses de acompañamiento.",
        "provider": {
          "@type": "Organization",
          "name": "Suelos Vivos — Bosque Madre",
          "url": "https://www.suelosvivos.com"
        },
        "courseMode": "Blended",
        "inLanguage": "es",
        "offers": {
          "@type": "Offer",
          "price": "1900",
          "priceCurrency": "EUR",
          "availability": "https://schema.org/LimitedAvailability"
        },
        "numberOfCredits": 3,
        "hasCourseInstance": {
          "@type": "CourseInstance",
          "startDate": "2026-09",
          "location": {
            "@type": "Place",
            "name": "Tormos, Alicante",
            "addressCountry": "ES"
          }
        }
      }
    </script>
  </head>
  <body>
    <slot />
    <CookieConsent lang={lang} />
  </body>
</html>
