---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { getLang, localePath, t } from '@/i18n/utils';

// A diferencia del aviso legal y la política de privacidad, esta página sí está
// traducida: es a la que lleva el aviso de cookies, y el aviso sale en el idioma
// del visitante.
const lang = getLang(Astro.currentLocale);
const rows: string[][] = t(lang, 'politicaCookies.list.rows');
const metaPrivacyUrl = 'https://www.facebook.com/privacy/policy/';
---

<BaseLayout
  title={t(lang, 'politicaCookies.seo.title')}
  description={t(lang, 'politicaCookies.seo.description')}
>
  <Header lang={lang} />

  <main class="pt-32 pb-24">
    <div class="container max-w-3xl">
      <h1 class="font-display text-4xl text-[#1E1A15] mb-4">{t(lang, 'politicaCookies.title')}</h1>
      <p class="text-[#6B6355] mb-12">{t(lang, 'politicaCookies.updated')}</p>

      <div class="prose-content space-y-8 text-[#6B6355] leading-relaxed">

        <section>
          <h2 class="font-display text-2xl text-[#1E1A15] mb-4">{t(lang, 'politicaCookies.what.h')}</h2>
          <p>{t(lang, 'politicaCookies.what.p')}</p>
        </section>

        <section>
          <h2 class="font-display text-2xl text-[#1E1A15] mb-4">{t(lang, 'politicaCookies.list.h')}</h2>
          <p class="mb-4">{t(lang, 'politicaCookies.list.intro')}</p>
          <div class="overflow-x-auto">
            <table class="w-full text-sm text-left border-collapse">
              <thead class="text-[#1E1A15]">
                <tr class="border-b border-[#DDD8CE]">
                  <th scope="col" class="py-2 pr-4 font-semibold">{t(lang, 'politicaCookies.list.cols.name')}</th>
                  <th scope="col" class="py-2 pr-4 font-semibold">{t(lang, 'politicaCookies.list.cols.owner')}</th>
                  <th scope="col" class="py-2 pr-4 font-semibold">{t(lang, 'politicaCookies.list.cols.purpose')}</th>
                  <th scope="col" class="py-2 font-semibold">{t(lang, 'politicaCookies.list.cols.duration')}</th>
                </tr>
              </thead>
              <tbody>
                {rows.map(([name, owner, purpose, duration]) => (
                  <tr class="border-b border-[#DDD8CE] align-top">
                    <td class="py-3 pr-4 font-mono text-xs text-[#1E1A15] whitespace-nowrap">{name}</td>
                    <td class="py-3 pr-4 whitespace-nowrap">{owner}</td>
                    <td class="py-3 pr-4 min-w-60">{purpose}</td>
                    <td class="py-3 whitespace-nowrap">{duration}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="mt-4">{t(lang, 'politicaCookies.list.note')}</p>
        </section>

        <section>
          <h2 class="font-display text-2xl text-[#1E1A15] mb-4">{t(lang, 'politicaCookies.meta.h')}</h2>
          <p>
            {t(lang, 'politicaCookies.meta.p')}{' '}
            <a href={metaPrivacyUrl} target="_blank" rel="noopener" class="text-[#8B1A1A] underline hover:text-[#6B1212] transition-colors">{t(lang, 'politicaCookies.meta.link')}</a>.
          </p>
        </section>

        <section>
          <h2 class="font-display text-2xl text-[#1E1A15] mb-4">{t(lang, 'politicaCookies.manage.h')}</h2>
          <p>{t(lang, 'politicaCookies.manage.p1')}</p>
          <p class="mt-3">{t(lang, 'politicaCookies.manage.p2')}</p>
          <button
            type="button"
            data-cookie-settings
            class="mt-4 min-h-11 px-5 rounded-md border border-[#1E1A15] text-sm font-semibold text-[#1E1A15] hover:bg-[#1E1A15] hover:text-[#FAFAF7] transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#8B1A1A]"
          >
            {t(lang, 'politicaCookies.manage.button')}
          </button>
          <p class="mt-4">{t(lang, 'politicaCookies.manage.p3')}</p>
        </section>

        <section>
          <h2 class="font-display text-2xl text-[#1E1A15] mb-4">{t(lang, 'politicaCookies.updates.h')}</h2>
          <p>
            {t(lang, 'politicaCookies.updates.p')}{' '}
            <a href={localePath(lang, '/politica-privacidad')} class="text-[#8B1A1A] underline hover:text-[#6B1212] transition-colors">{t(lang, 'politicaCookies.privacyLink')}</a>.
          </p>
        </section>

      </div>
    </div>
  </main>

  <Footer lang={lang} />
</BaseLayout>
