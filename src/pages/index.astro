  </main>

  <Footer lang={lang} />
</BaseLayout>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    // Hero entrance
    gsap.set(
      [
        ".hero-eyebrow",
        ".hero-title",
        ".hero-subtitle",
        ".hero-actions",
        ".hero-stats",
      ],
      { opacity: 0 },
    );

    gsap
      .timeline({ defaults: { ease: "power3.out" }, delay: 0.1 })
      .fromTo(
        ".hero-eyebrow",
        { y: 16, opacity: 0 },
        { y: 0, opacity: 1, duration: 0.7 },
      )
      .fromTo(
        ".hero-title",
        { y: 48, opacity: 0 },
        { y: 0, opacity: 1, duration: 1.0 },
        "-=0.4",
      )
      .fromTo(
        ".hero-subtitle",
        { y: 24, opacity: 0 },
        { y: 0, opacity: 1, duration: 0.8 },
        "-=0.6",
      )
      .fromTo(
        ".hero-actions",
        { y: 20, opacity: 0 },
        { y: 0, opacity: 1, duration: 0.7 },
        "-=0.55",
      )
      .fromTo(
        ".hero-stats",
        { y: 16, opacity: 0 },
        { y: 0, opacity: 1, duration: 0.6 },
        "-=0.45",
      );

    // Problem section
    gsap.from(".problem-eyebrow, .problem-title, .problem-subtitle", {
      y: 32,
      opacity: 0,
      duration: 0.8,
      stagger: 0.12,
      ease: "power3.out",
      scrollTrigger: {
        trigger: ".problem-eyebrow",
        start: "top 85%",
        once: true,
      },
    });

    gsap.fromTo(
      ".pain-card",
      { y: 40, opacity: 0 },
      {
        y: 0,
        opacity: 1,
        duration: 0.7,
        stagger: 0.1,
        ease: "power3.out",
        scrollTrigger: {
          trigger: ".problem-eyebrow",
          start: "top 70%",
          once: true,
        },
      },
    );

    gsap.fromTo(
      ".problem-quote",
      { y: 32, opacity: 0 },
      {
        y: 0,
        opacity: 1,
        duration: 0.9,
        ease: "power3.out",
        scrollTrigger: {
          trigger: ".problem-eyebrow",
          start: "top 50%",
          once: true,
        },
      },
    );

    // Ecosystem section
    gsap.from(".ecosystem-eyebrow, .ecosystem-title", {
      y: 32,
      opacity: 0,
      duration: 0.8,
      stagger: 0.12,
      ease: "power3.out",
      scrollTrigger: {
        trigger: ".ecosystem-eyebrow",
        start: "top 85%",
        once: true,
      },
    });

    gsap.fromTo(
      ".ecosystem-card",
      { y: 40, opacity: 0 },
      {
        y: 0,
        opacity: 1,
        duration: 0.8,
        stagger: 0.15,
        ease: "power3.out",
        scrollTrigger: {
          trigger: ".ecosystem-card",
          start: "top 82%",
          once: true,
        },
      },
    );

    // Workshops
    gsap.from(".workshops-eyebrow, .workshops-title, .workshops-subtitle", {
      y: 32,
      opacity: 0,
      duration: 0.8,
      stagger: 0.12,
      ease: "power3.out",
      scrollTrigger: {
        trigger: ".workshops-eyebrow",
        start: "top 85%",
        once: true,
      },
    });

    gsap.fromTo(
      ".workshop-card",
      { y: 40, opacity: 0 },
      {
        y: 0,
        opacity: 1,
        duration: 0.8,
        stagger: 0.12,
        ease: "power3.out",
        scrollTrigger: {
          trigger: ".workshops-eyebrow",
          start: "top 70%",
          once: true,
        },
      },
    );

    gsap.fromTo(
      ".workshop-photo-card",
      { y: 30, opacity: 0 },
      {
        y: 0,
        opacity: 1,
        duration: 0.7,
        stagger: 0.08,
        ease: "power3.out",
        scrollTrigger: {
          trigger: ".workshops-gallery",
          start: "top 85%",
          once: true,
        },
      },
    );

    // Audience section
    gsap.from(".audience-eyebrow, .audience-title", {
      y: 32,
      opacity: 0,
      duration: 0.8,
      stagger: 0.1,
      ease: "power3.out",
      scrollTrigger: {
        trigger: ".audience-eyebrow",
        start: "top 85%",
        once: true,
      },
    });

    gsap.fromTo(
      ".audience-item",
      { x: -24, opacity: 0 },
      {
        x: 0,
        opacity: 1,
        duration: 0.6,
        stagger: 0.08,
        ease: "power3.out",
        scrollTrigger: {
          trigger: ".audience-eyebrow",
          start: "top 70%",
          once: true,
        },
      },
    );

    // Gallery
    gsap.fromTo(
      ".gallery-item",
      { y: 32, opacity: 0 },
      {
        y: 0,
        opacity: 1,
        duration: 0.7,
        stagger: 0.08,
        ease: "power3.out",
        scrollTrigger: {
          trigger: ".gallery-item",
          start: "top bottom",
          once: true,
        },
      },
    );

    // Benefits
    gsap.from(".benefits-eyebrow, .benefits-title", {
      y: 32,
      opacity: 0,
      duration: 0.8,
      stagger: 0.1,
      ease: "power3.out",
      scrollTrigger: {
        trigger: ".benefits-eyebrow",
        start: "top 85%",
        once: true,
      },
    });

    gsap.fromTo(
      ".benefit-card",
      { y: 40, opacity: 0 },
      {
        y: 0,
        opacity: 1,
        duration: 0.7,
        stagger: 0.1,
        ease: "power3.out",
        scrollTrigger: {
          trigger: ".benefits-eyebrow",
          start: "top 70%",
          once: true,
        },
      },
    );

    // About section
    gsap.from(".about-eyebrow, .about-title, .about-text", {
      y: 32,
      opacity: 0,
      duration: 0.8,
      stagger: 0.1,
      ease: "power3.out",
      scrollTrigger: {
        trigger: ".about-eyebrow",
        start: "top 85%",
        once: true,
      },
    });

    // Services section
    gsap.from(".services-eyebrow, .services-title, .services-subtitle", {
      y: 32,
      opacity: 0,
      duration: 0.8,
      stagger: 0.12,
      ease: "power3.out",
      scrollTrigger: {
        trigger: ".services-eyebrow",
        start: "top 85%",
        once: true,
      },
    });

    gsap.fromTo(
      ".service-card",
      { y: 40, opacity: 0 },
      {
        y: 0,
        opacity: 1,
        duration: 0.7,
        stagger: 0.1,
        ease: "power3.out",
        scrollTrigger: { trigger: "#servicios", start: "top 70%", once: true },
      },
    );

    gsap.fromTo(
      ".waitlist-banner",
      { y: 24, opacity: 0 },
      {
        y: 0,
        opacity: 1,
        duration: 0.7,
        ease: "power3.out",
        scrollTrigger: { trigger: ".waitlist-banner", start: "top 88%", once: true },
      },
    );
  }

  // Waitlist form submission
  const waitlistForm = document.getElementById("waitlist-form") as HTMLFormElement | null;
  const waitlistSubmit = document.getElementById("waitlist-submit") as HTMLButtonElement | null;
  const waitlistSuccess = document.getElementById("waitlist-success");
  const waitlistError = document.getElementById("waitlist-error");

  waitlistForm?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!waitlistSubmit || !waitlistForm) return;

    const labelSending = waitlistSubmit.dataset.labelSending ?? "...";
    const labelSent = waitlistSubmit.dataset.labelSent ?? "✓";
    const labelSubmit = waitlistSubmit.dataset.labelSubmit ?? waitlistSubmit.textContent ?? "";

    waitlistSubmit.disabled = true;
    waitlistSubmit.textContent = labelSending;
    waitlistSuccess?.classList.add("hidden");
    waitlistError?.classList.add("hidden");

    try {
      const res = await fetch(waitlistForm.action, {
        method: "POST",
        body: new FormData(waitlistForm),
        headers: { Accept: "application/json" },
      });

      if (!res.ok) throw new Error("request failed");

      waitlistSubmit.textContent = labelSent;
      waitlistForm.reset();
      waitlistSuccess?.classList.remove("hidden");
    } catch {
      waitlistSubmit.disabled = false;
      waitlistSubmit.textContent = labelSubmit;
      waitlistError?.classList.remove("hidden");
    }
  });
</script>
