          <p class="services-subtitle text-[#6B6355] text-lg leading-relaxed">
            {t(lang, "home.services.subtitle2")}
          </p>
        </div>

        <div
          class="grid md:grid-cols-2 lg:grid-cols-3 gap-5 max-w-5xl mx-auto mb-12"
        >
          {
            (
              t(lang, "home.services.items") as {
                title: string;
                desc: string;
              }[]
            ).map((s, i) => (
              <div class="service-card flex flex-col gap-4 p-6 bg-white border border-[#DDD8CE] rounded-lg hover:shadow-md hover:border-[#C4622D]/40 transition-all duration-300">
                <div class="w-10 h-10 rounded-md bg-[#F0F2EE] flex items-center justify-center text-[#C4622D] shrink-0">
                  <svg
                    class="w-5 h-5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    set:html={serviceIcons[i]}
                  />
                </div>
                <div>
                  <h3 class="font-semibold text-[#1E1A15] mb-2">{s.title}</h3>
                  <p class="text-sm text-[#6B6355] leading-relaxed">{s.desc}</p>
                </div>
              </div>
            ))
          }
        </div>

        <div class="text-center">
          <a
            href="/servicios"
            class="inline-flex items-center gap-2 px-8 py-3.5 bg-[#8B1A1A] text-[#FAFAF7] font-semibold rounded-md hover:bg-[#6B1212] transition-colors duration-200 text-sm"
          >
            {t(lang, "home.services.cta")}
            <svg
              class="w-4 h-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
