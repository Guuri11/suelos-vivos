    <!-- ASESORÍA / SERVICIOS -->
    <section id="servicios" class="py-24 bg-[#FAFAF7]">
      <div class="container">
        <div class="max-w-3xl mx-auto text-center mb-16">
          <p
            class="services-eyebrow text-xs font-semibold uppercase tracking-[0.18em] text-[#6B8F71] mb-4"
          >
            {t(lang, "home.services.eyebrow")}
          </p>
          <h2
            class="services-title font-display text-3xl md:text-5xl text-[#1E1A15] mb-6"
          >
            {t(lang, "home.services.title")}
