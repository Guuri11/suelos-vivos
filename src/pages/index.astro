---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { siteConfig } from "@/config/site";
import { getLang, t } from "@/i18n/utils";

const lang = getLang(Astro.currentLocale);

const problemIcons = [
  `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>`,
  `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>`,
  `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z"/>`,
  `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>`,
];

const benefitVisuals: (
  | { type: "img"; src: string }
  | { type: "svg"; path: string }
)[] = [
  {
    type: "img",
    src: "/images/bullets/bullet-1-mejora-autonomia-transparent.png",
  },
  {
    type: "img",
    src: "/images/bullets/bullet-2-disfruta-acompañamiento-transparent.png",
  },
  {
    type: "svg",
    path: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>`,
  },
  {
    type: "svg",
    path: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>`,
  },
];

const serviceIcons = [
  `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/>`,
  `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>`,
  `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z"/>`,
  `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>`,
  `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/>`,
];
---

<BaseLayout
  title={t(lang, "home.seo.title")}
  description={t(lang, "home.seo.description")}
>
  <Header lang={lang} />

  <main>
    <!-- HERO -->
    <section
      class="hero relative min-h-screen flex items-center justify-center overflow-hidden"
    >
      <div class="absolute inset-0">
        <img
          src="/images/driver-prueba/IMG_6930.jpg"
          alt={t(lang, "home.hero.imgAlt")}
          class="w-full h-full object-cover"
          loading="eager"
        />
        <div class="absolute inset-0 bg-[#1E1A15]/65"></div>
      </div>

      <div
        class="hero-content relative z-10 container text-center text-[#FAFAF7] py-24 pt-40"
      >
        <p
          class="hero-eyebrow inline-block text-xs font-semibold tracking-[0.2em] uppercase text-[#C4622D] mb-6"
        >
          {t(lang, "home.hero.eyebrow")}
        </p>
        <h1
          class="hero-title font-display text-4xl md:text-6xl lg:text-7xl leading-[1.05] mb-6 max-w-4xl mx-auto"
        >
          {t(lang, "home.hero.title")}
        </h1>
        <p
          class="hero-subtitle text-lg md:text-xl text-[#FAFAF7]/80 max-w-2xl mx-auto mb-4 leading-relaxed"
        >
          {t(lang, "home.hero.subtitleP1")}
        </p>
        <p
          class="hero-subtitle text-lg md:text-xl text-[#FAFAF7]/80 max-w-2xl mx-auto mb-10 leading-relaxed"
        >
          {t(lang, "home.hero.subtitleP2")}
        </p>
        <div
          class="hero-actions flex flex-col sm:flex-row gap-4 justify-center items-center"
        >
          <a
            href="/el-programa"
            class="inline-flex items-center px-8 py-4 bg-[#8B1A1A] text-[#FAFAF7] font-semibold rounded-md hover:bg-[#6B1212] transition-colors duration-200 text-base"
          >
            {t(lang, "home.hero.ctaPrograma")}
          </a>
          <a
            href="/servicios"
            class="inline-flex items-center px-8 py-4 border border-[#FAFAF7]/40 text-[#FAFAF7] font-medium rounded-md hover:border-[#FAFAF7]/80 hover:bg-[#FAFAF7]/10 transition-colors duration-200 text-base"
          >
            {t(lang, "home.hero.ctaAsesoria")}
          </a>
        </div>

        <!-- Stats -->
        <div
          class="hero-stats mt-16 grid grid-cols-3 gap-6 max-w-lg mx-auto border-t border-[#FAFAF7]/20 pt-10"
        >
          {
            (
              t(lang, "home.hero.stats") as { value: string; label: string }[]
            ).map((s) => (
              <div>
                <p class="text-3xl font-display text-[#C4622D]">{s.value}</p>
                <p class="text-xs text-[#FAFAF7]/60 uppercase tracking-wider mt-1">
                  {s.label}
                </p>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Scroll indicator -->
      <div
        class="absolute bottom-8 left-1/2 -translate-x-1/2 text-[#FAFAF7]/40 animate-bounce"
      >
        <svg
          class="w-5 h-5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.5"
            d="M19 9l-7 7-7-7"></path>
        </svg>
      </div>
    </section>

    <!-- PROBLEMA: El círculo vicioso -->
    <section class="py-24 bg-[#FAFAF7]">
      <div class="container">
        <div class="max-w-3xl mx-auto text-center mb-16">
          <p
            class="problem-eyebrow text-xs font-semibold uppercase tracking-[0.18em] text-[#6B8F71] mb-4"
          >
            {t(lang, "home.problem.eyebrow")}
          </p>
          <h2
            class="problem-title font-display text-3xl md:text-5xl text-[#1E1A15] mb-6"
          >
            {t(lang, "home.problem.title")}
          </h2>
          <p class="problem-subtitle text-[#6B6355] text-lg leading-relaxed">
            {t(lang, "home.problem.subtitle")}
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-6 max-w-4xl mx-auto mb-16">
          {
            (
              t(lang, "home.problem.items") as { title: string; desc: string }[]
            ).map((item, i) => (
              <div class="pain-card flex gap-4 p-6 bg-white border border-[#DDD8CE] rounded-lg">
                <div class="shrink-0 w-10 h-10 rounded-md bg-[#F0F2EE] flex items-center justify-center text-[#8B1A1A]">
                  <svg
                    class="w-5 h-5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    set:html={problemIcons[i]}
                  />
                </div>
                <div>
                  <h3 class="font-semibold text-[#1E1A15] mb-1">
                    {item.title}
                  </h3>
                  <p class="text-sm text-[#6B6355] leading-relaxed">
                    {item.desc}
                  </p>
                </div>
              </div>
            ))
          }
        </div>

        <blockquote class="problem-quote max-w-3xl mx-auto text-center">
          <p
            class="font-display text-2xl md:text-3xl text-[#8B1A1A] leading-snug mb-4"
          >
            "{t(lang, "home.problem.quote")}"
          </p>
          <cite class="text-sm text-[#6B6355] not-italic"
            >{t(lang, "home.problem.quoteAuthor")}</cite
          >
        </blockquote>
      </div>
    </section>

    <!-- ECOSISTEMA / PLATAFORMA -->
    <section class="py-24 bg-[#1E1A15] text-[#FAFAF7]">
      <div class="container">
        <div class="max-w-3xl mx-auto text-center mb-16">
          <p
            class="ecosystem-eyebrow text-xs font-semibold uppercase tracking-[0.18em] text-[#C4622D] mb-4"
          >
            {t(lang, "home.ecosystem.eyebrow")}
          </p>
          <h2
            class="ecosystem-title font-display text-3xl md:text-5xl mb-6 leading-tight"
          >
            {t(lang, "home.ecosystem.title")}
          </h2>
          <p class="text-[#FAFAF7]/70 text-lg leading-relaxed">
            {t(lang, "home.ecosystem.intro")}
          </p>
        </div>
        <div class="grid md:grid-cols-3 gap-6 max-w-5xl mx-auto">
          {
            (
              t(lang, "home.ecosystem.items") as {
                title: string;
                desc: string;
              }[]
            ).map((item, i) => (
              <div class="ecosystem-card p-8 bg-[#FAFAF7]/5 border border-[#FAFAF7]/10 rounded-xl hover:bg-[#FAFAF7]/[0.08] transition-colors duration-300">
                <p class="font-display text-4xl text-[#C4622D] mb-4 leading-none">
                  {String(i + 1).padStart(2, "0")}
                </p>
                <h3 class="font-semibold text-[#FAFAF7] mb-3">{item.title}</h3>
                <p class="text-sm text-[#FAFAF7]/60 leading-relaxed">
                  {item.desc}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- LOS TALLERES -->
    <section class="py-24 bg-[#F0F2EE]">
      <div class="container">
        <div class="max-w-3xl mx-auto text-center mb-16">
          <p
            class="workshops-eyebrow text-xs font-semibold uppercase tracking-[0.18em] text-[#6B8F71] mb-4"
          >
            {t(lang, "home.workshops.eyebrow")}
          </p>
          <h2
            class="workshops-title font-display text-3xl md:text-5xl text-[#1E1A15] mb-6"
          >
            {t(lang, "home.workshops.title")}
          </h2>
          <p class="workshops-subtitle text-[#6B6355] text-lg leading-relaxed">
            {t(lang, "home.workshops.subtitle")}
          </p>
        </div>

        <div
          class="workshops-gallery grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3 md:gap-4 mb-16"
        >
          {
            (
              t(lang, "home.workshops.gallery") as {
                image: string;
                title: string;
                text: string;
              }[]
            ).map((photo) => (
              <div class="workshop-photo-card group relative aspect-square rounded-lg overflow-hidden">
                <img
                  src={photo.image}
                  alt={photo.title}
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-[#1E1A15]/90 via-[#1E1A15]/25 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col justify-end p-4">
                  <h3 class="text-white font-semibold text-sm mb-1">
                    {photo.title}
                  </h3>
                  <p class="text-white/85 text-xs leading-snug">
                    {photo.text}
                  </p>
                </div>
              </div>
            ))
          }
        </div>

        <div class="grid md:grid-cols-3 gap-6">
          {
            (
              t(lang, "home.workshops.items") as {
                label: string;
                value: string;
                title: string;
                desc: string;
              }[]
            ).map((w) => (
              <div class="workshop-card bg-white border border-[#DDD8CE] rounded-lg p-8 hover:shadow-md transition-shadow duration-300">
                <p class="text-xs font-semibold uppercase tracking-[0.15em] text-[#6B8F71] mb-4">
                  {w.label}
                </p>
                <p class="font-display text-6xl text-[#8B1A1A] mb-3 leading-none">
                  {w.value}
                </p>
                <h3 class="font-semibold text-[#1E1A15] mb-3">{w.title}</h3>
                <p class="text-sm text-[#6B6355] leading-relaxed">{w.desc}</p>
              </div>
            ))
          }
        </div>

        <p class="text-center text-sm text-[#6B6355] mt-8">
          {t(lang, "home.workshops.companionPre")}{siteConfig.program.months}{
            t(lang, "home.workshops.companionPost")
          }
        </p>
      </div>
    </section>

    <!-- EDICIÓN ONLINE — LISTA DE ESPERA -->
    <section class="py-16 bg-[#FAFAF7]">
      <div class="container">
        <div
          class="waitlist-banner max-w-3xl mx-auto bg-[#6B8F71]/10 border border-[#6B8F71]/30 rounded-xl p-8 md:p-10 text-center"
        >
          <div
            class="w-12 h-12 mx-auto mb-5 rounded-full bg-[#6B8F71]/15 flex items-center justify-center"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="w-6 h-6 text-[#6B8F71]"
            >
              <rect x="3" y="4" width="18" height="12" rx="1.5" />
              <path d="M2 20h20" />
              <path d="M9 20l1-4h4l1 4" />
            </svg>
          </div>
          <h3 class="font-display text-2xl md:text-3xl text-[#1E1A15] mb-3">
            {t(lang, "home.onlineWaitlist.title")}
          </h3>
          <p class="text-[#6B6355] leading-relaxed mb-6 max-w-xl mx-auto">
            {t(lang, "home.onlineWaitlist.desc")}
          </p>

          <form
            action="/api/waitlist"
            method="POST"
            id="waitlist-form"
            class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto"
          >
            <label for="waitlist-email" class="sr-only">
              {t(lang, "home.onlineWaitlist.emailLabel")}
            </label>
            <input
              type="email"
              id="waitlist-email"
              name="email"
              required
              autocomplete="email"
              class="flex-1 px-4 py-3 border border-[#DDD8CE] rounded-md bg-white text-[#1E1A15] placeholder-[#6B6355]/50 focus:outline-none focus:ring-2 focus:ring-[#6B8F71]/30 focus:border-[#6B8F71] transition-colors text-sm"
              placeholder={t(lang, "home.onlineWaitlist.placeholder") as string}
            />
            <input type="hidden" name="tipo" value="waitlist-home" />
            <input type="hidden" name="lang" value={lang} />
            <input type="text" name="_gotcha" class="hidden" tabindex="-1" autocomplete="off" />
            <button
              type="submit"
              id="waitlist-submit"
              data-label-submit={t(lang, "home.onlineWaitlist.cta")}
              data-label-sending={t(lang, "home.onlineWaitlist.sending")}
              data-label-sent={t(lang, "home.onlineWaitlist.sent")}
              class="px-6 py-3 bg-[#6B8F71] text-white font-semibold rounded-md hover:bg-[#587A5D] disabled:opacity-60 disabled:cursor-not-allowed transition-colors duration-200 text-sm whitespace-nowrap cursor-pointer"
            >
              {t(lang, "home.onlineWaitlist.cta")}
            </button>
          </form>

          <p
            id="waitlist-success"
            class="hidden mt-4 text-sm text-[#6B8F71] font-medium"
          >
            {t(lang, "home.onlineWaitlist.successMsg")}
          </p>
          <p id="waitlist-error" class="hidden mt-4 text-sm text-[#8B1A1A] font-medium">
            {t(lang, "home.onlineWaitlist.errorPrefix")} {siteConfig.contact.email}
          </p>
        </div>
      </div>
    </section>

    <!-- PARA QUIÉN -->
    <section class="py-24 bg-[#FAFAF7]">
      <div class="container">
        <div class="grid md:grid-cols-2 gap-16 items-center max-w-5xl mx-auto">
          <div>
            <p
              class="audience-eyebrow text-xs font-semibold uppercase tracking-[0.18em] text-[#6B8F71] mb-4"
            >
              {t(lang, "home.audience.eyebrow")}
            </p>
            <h2
              class="audience-title font-display text-3xl md:text-4xl text-[#1E1A15] mb-8 leading-tight"
            >
              {t(lang, "home.audience.title")}
            </h2>
            <ul class="space-y-4">
              {
                (t(lang, "home.audience.items") as string[]).map((item) => (
                  <li class="audience-item flex gap-3 text-[#1E1A15]">
                    <svg
                      class="w-5 h-5 text-[#6B8F71] shrink-0 mt-0.5"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M5 13l4 4L19 7"
                      />
                    </svg>
                    <span class="text-[#6B6355]">{item}</span>
                  </li>
                ))
              }
            </ul>
          </div>
          <div class="relative">
            <img
              src="/images/driver-prueba/DJI_20260608184728_0304_D.jpg"
              alt={t(lang, "home.audience.imgAlt")}
              class="rounded-lg w-full aspect-[4/3] object-cover shadow-lg"
              loading="lazy"
            />
            <div
              class="absolute -bottom-6 -left-6 bg-white border border-[#DDD8CE] rounded-lg p-4 shadow-md"
            >
              <p class="text-xs text-[#6B6355] mb-1">
                {t(lang, "home.audience.statsLabel1")}
              </p>
              <p class="font-display text-3xl text-[#8B1A1A]">
                {t(lang, "home.audience.statsValue")}
              </p>
              <p class="text-xs text-[#6B6355]">
                {t(lang, "home.audience.statsLabel2")}
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- GALERÍA -->
    <section class="py-16 bg-[#F0F2EE]">
      <div class="container">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
          {
            ["campo-1.jpg", "campo-2.jpg", "suelo.jpg", "grupo.jpg"].map(
              (img) => (
                <div class="gallery-item aspect-square rounded-lg overflow-hidden">
                  <img
                    src={`/images/${img}`}
                    alt={t(lang, "home.gallery.imgAlt")}
                    class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
                    loading="lazy"
                  />
                </div>
              ),
            )
          }
        </div>
      </div>
    </section>

    <!-- BENEFICIOS -->
    <section class="py-24 bg-[#FAFAF7]">
      <div class="container">
        <div class="max-w-3xl mx-auto text-center mb-16">
          <p
            class="benefits-eyebrow text-xs font-semibold uppercase tracking-[0.18em] text-[#6B8F71] mb-4"
          >
            {t(lang, "home.benefits.eyebrow")}
          </p>
          <h2
            class="benefits-title font-display text-3xl md:text-5xl text-[#1E1A15] mb-6"
          >
            {t(lang, "home.benefits.title")}
          </h2>
        </div>

        <div class="grid md:grid-cols-2 gap-8 max-w-3xl mx-auto">
          {
            (
              t(lang, "home.benefits.items") as {
                title: string;
                desc: string;
              }[]
            ).map((b, i) => (
              <div class="benefit-card flex flex-col gap-4">
                <div class="w-10 h-10 rounded-md bg-[#F0F2EE] flex items-center justify-center text-[#8B1A1A]">
                  {benefitVisuals[i].type === "img" ? (
                    <img
                      src={
                        (benefitVisuals[i] as { type: "img"; src: string }).src
                      }
                      class="w-9 h-9 object-contain"
                      style="mix-blend-mode: multiply;"
                      alt=""
                    />
                  ) : (
                    <svg
                      class="w-5 h-5"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                      set:html={
                        (benefitVisuals[i] as { type: "svg"; path: string })
                          .path
                      }
                    />
                  )}
                </div>
                <div>
                  <h3 class="font-semibold text-[#1E1A15] mb-2">{b.title}</h3>
                  <p class="text-sm text-[#6B6355] leading-relaxed">{b.desc}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- QUIÉNES SOMOS (mini) -->
    <section class="py-24 bg-[#F0F2EE]">
      <div class="container">
        <div class="grid md:grid-cols-2 gap-16 items-center max-w-5xl mx-auto">
          <div class="relative order-2 md:order-1">
            <img
              src="/images/driver-prueba/11-05-26_53.jpg"
              alt={t(lang, "home.about.imgAlt")}
              class="rounded-lg w-full aspect-[4/5] object-cover shadow-lg"
              loading="lazy"
            />
          </div>
          <div class="order-1 md:order-2">
            <p
              class="about-eyebrow text-xs font-semibold uppercase tracking-[0.18em] text-[#6B8F71] mb-4"
            >
              {t(lang, "home.about.eyebrow")}
            </p>
            <h2
              class="about-title font-display text-3xl md:text-4xl text-[#1E1A15] mb-6 leading-tight"
            >
              {t(lang, "home.about.title")}
            </h2>
            <div class="space-y-4 text-[#6B6355] leading-relaxed about-text">
              <p set:html={t(lang, "home.about.p1")} />
              <p>{t(lang, "home.about.p2")}</p>
              <p>{t(lang, "home.about.p3")}</p>
            </div>
            <a
              href="/quienes-somos"
              class="inline-flex items-center gap-2 mt-8 text-[#8B1A1A] font-semibold text-sm hover:gap-3 transition-all duration-200"
            >
              {t(lang, "home.about.link")}
              <svg
                class="w-4 h-4"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
              </svg>
