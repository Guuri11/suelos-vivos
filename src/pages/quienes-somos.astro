---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { siteConfig } from '@/config/site';
import { getLang, t, localePath } from '@/i18n/utils';

const lang = getLang(Astro.currentLocale);

// Retrato de Carles Pons: el cliente aún no lo ha enviado (03/09/2026). Mientras esté a
// null la ficha se pinta a una columna, para no dejar un hueco gris en producción. Cuando
// llegue la foto basta con poner aquí su ruta y la ficha vuelve a dos columnas.
const trainerPhoto: string | null = null;
---

<BaseLayout
  title={t(lang, 'quienesSomos.seo.title')}
  description={t(lang, 'quienesSomos.seo.description')}
>
  <Header lang={lang} />

  <main>
    <!-- Page header -->
    <section class="pt-32 pb-16 bg-[#F0F2EE]">
      <div class="container max-w-3xl">
        <p class="page-eyebrow text-xs font-semibold uppercase tracking-[0.18em] text-[#6B8F71] mb-4">{t(lang, 'quienesSomos.hero.eyebrow')}</p>
        <h1 class="page-title font-display text-4xl md:text-6xl text-[#1E1A15] leading-[1.05] mb-6" set:html={t(lang, 'quienesSomos.hero.title')} />
        <p class="page-subtitle text-[#6B6355] text-xl leading-relaxed">
          {t(lang, 'quienesSomos.hero.subtitle')}
        </p>

        <!-- El documento del cliente pide el logo justo aqui, entre la mision y el
             relato. Va alineado a la izquierda porque el hero lo esta, y al doble de
             altura que el del header para que se lea como firma del parrafo y no como
             una repeticion de la navegacion. Decorativo: la marca ya esta en el h1 y en
             el texto, asi que alt vacio y no se duplica en el lector de pantalla. -->
        <img
          src={siteConfig.logo.src}
          alt=""
          width={siteConfig.logo.width}
          height={siteConfig.logo.height}
          class="page-logo mt-10 h-12 md:h-14 w-auto"
          loading="eager"
          decoding="async"
        />
      </div>
    </section>

    <!-- Intro e historia -->
    <section class="py-24 bg-[#FAFAF7]">
      <div class="container max-w-5xl">
        <div class="intro-section grid md:grid-cols-2 gap-16 items-center mb-24">
          <div class="relative order-2 md:order-1">
            <img
              src="/images/finca/11-05-26_53.jpg"
              alt={t(lang, 'quienesSomos.intro.imgAlt')}
              class="rounded-lg w-full aspect-[4/3] object-cover shadow-lg"
              loading="lazy"
            />
          </div>
          <div class="order-1 md:order-2 space-y-5 text-[#6B6355] leading-relaxed intro-text">
            {(t(lang, 'quienesSomos.intro.paragraphs') as string[]).map(p => (
              <p set:html={p} />
            ))}
          </div>
        </div>

        <div class="grid md:grid-cols-2 gap-16 items-center mb-24">
          <div>
            <h2 class="story-title font-display text-3xl md:text-4xl text-[#1E1A15] mb-8 leading-tight">
              {t(lang, 'quienesSomos.story.title')}
            </h2>
            <div class="space-y-5 text-[#6B6355] leading-relaxed story-text">
              {(t(lang, 'quienesSomos.story.paragraphs') as string[]).map(p => (
                <p set:html={p} />
              ))}
            </div>
          </div>
          <div class="relative">
            <img
              src="/images/campo-3.jpg"
              alt="Finca de Bosque Madre en Tormos, Alicante"
              class="rounded-lg w-full aspect-[4/5] object-cover shadow-lg"
              loading="lazy"
            />
          </div>
        </div>

        <!-- Valores -->
        <div class="values-section mb-24">
          <h2 class="font-display text-3xl text-[#1E1A15] mb-12 text-center">{t(lang, 'quienesSomos.values.title')}</h2>
          <div class="grid md:grid-cols-3 gap-8">
            {(t(lang, 'quienesSomos.values.items') as {title: string; desc: string}[]).map(v => (
              <div class="value-card p-8 bg-[#F0F2EE] rounded-lg border border-[#DDD8CE]">
                <h3 class="font-semibold text-[#1E1A15] mb-3">{v.title}</h3>
                <p class="text-sm text-[#6B6355] leading-relaxed">{v.desc}</p>
              </div>
            ))}
          </div>
        </div>

        <!-- Formador principal -->
        <div class="trainer-section mb-24">
          <div class="bg-[#F0F2EE] border border-[#DDD8CE] rounded-xl p-8 md:p-12">
            <div class:list={['grid gap-12 items-start', trainerPhoto && 'md:grid-cols-[2fr_3fr]']}>
              {trainerPhoto && (
                <img
                  src={trainerPhoto}
                  alt={t(lang, 'quienesSomos.trainer.imgAlt')}
                  class="rounded-lg w-full aspect-[4/5] object-cover shadow-lg"
                  loading="lazy"
                />
              )}
              <div class={trainerPhoto ? '' : 'max-w-3xl'}>
                <p class="text-xs font-semibold uppercase tracking-[0.18em] text-[#6B8F71] mb-4">
                  {t(lang, 'quienesSomos.trainer.eyebrow')}
                </p>
                <h2 class="font-display text-3xl md:text-4xl text-[#1E1A15] leading-tight">
                  {t(lang, 'quienesSomos.trainer.name')}
                </h2>
                <p class="text-sm font-medium text-[#C4622D] mt-2 mb-6">
                  {t(lang, 'quienesSomos.trainer.role')}
                </p>
                <p class="text-[#6B6355] leading-relaxed mb-8">
                  {t(lang, 'quienesSomos.trainer.bio')}
                </p>

                <h3 class="text-xs font-semibold uppercase tracking-[0.18em] text-[#1E1A15] mb-4">
                  {t(lang, 'quienesSomos.trainer.areasTitle')}
                </h3>
                <ul class="grid sm:grid-cols-2 gap-x-8 gap-y-2">
                  {(t(lang, 'quienesSomos.trainer.areas') as string[]).map(area => (
                    <li class="flex gap-3 text-sm text-[#6B6355] leading-relaxed">
                      <span class="mt-[0.55em] h-1 w-1 shrink-0 rounded-full bg-[#6B8F71]" aria-hidden="true"></span>
                      {area}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        </div>

        <!-- El lugar -->
        <div class="location-section grid md:grid-cols-2 gap-16 items-center mb-24">
          <div class="grid grid-cols-2 gap-3">
            <img src="/images/campo-1.jpg" alt="Campo en Tormos" class="rounded-lg w-full aspect-square object-cover" loading="lazy" />
            <img src="/images/campo-2.jpg" alt="Campos de Bosque Madre" class="rounded-lg w-full aspect-square object-cover mt-6" loading="lazy" />
            <img src="/images/campo-4.jpg" alt="Detalle de suelo vivo" class="rounded-lg w-full aspect-square object-cover" loading="lazy" />
            <img src="/images/suelo.jpg" alt="Suelo con vida" class="rounded-lg w-full aspect-square object-cover mt-6" loading="lazy" />
          </div>
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-[#6B8F71] mb-4">{t(lang, 'quienesSomos.location.eyebrow')}</p>
            <h2 class="font-display text-3xl text-[#1E1A15] mb-6 leading-tight">
              {t(lang, 'quienesSomos.location.title')}
            </h2>
            <p class="text-[#6B6355] leading-relaxed mb-4">
              {t(lang, 'quienesSomos.location.desc1')}
            </p>
            <p class="text-[#6B6355] leading-relaxed mb-6">
              {t(lang, 'quienesSomos.location.desc2')}
            </p>
            <div class="flex items-center gap-2 text-[#6B6355] text-sm">
              <svg class="w-4 h-4 text-[#8B1A1A]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
              {t(lang, 'quienesSomos.location.place')}
            </div>
          </div>
        </div>

        <!-- Bosque Madre link -->
        <div class="bg-[#1E1A15] text-[#FAFAF7] rounded-xl p-10 text-center">
          <p class="text-xs font-semibold uppercase tracking-wider text-[#C4622D] mb-3">{t(lang, 'quienesSomos.bosqueMadre.eyebrow')}</p>
          <h2 class="font-display text-3xl mb-4">{t(lang, 'quienesSomos.bosqueMadre.title')}</h2>
          <p class="text-[#FAFAF7]/70 max-w-lg mx-auto mb-8 leading-relaxed">
            {t(lang, 'quienesSomos.bosqueMadre.desc')}
          </p>
          <a
            href={siteConfig.bosqueMadre.url}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 px-6 py-3 border border-[#FAFAF7]/30 text-[#FAFAF7] rounded-md hover:border-[#FAFAF7]/60 hover:bg-[#FAFAF7]/10 transition-colors duration-200 text-sm font-medium"
          >
            {t(lang, 'quienesSomos.bosqueMadre.linkText')}
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
            </svg>
          </a>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="page-cta py-16 bg-[#F0F2EE] border-t border-[#DDD8CE]">
      <div class="container text-center">
        <h2 class="font-display text-3xl text-[#1E1A15] mb-4">{t(lang, 'quienesSomos.cta.title')}</h2>
        <p class="text-[#6B6355] mb-8 max-w-xl mx-auto">{t(lang, 'quienesSomos.cta.subtitle')}</p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
          <a
            href={localePath(lang, '/el-programa')}
            class="inline-flex items-center px-8 py-4 bg-[#8B1A1A] text-[#FAFAF7] font-semibold rounded-md hover:bg-[#6B1212] transition-colors duration-200 text-base"
          >
            {t(lang, 'quienesSomos.cta.btnPrograma')}
          </a>
          <a
            href={localePath(lang, '/servicios')}
            class="inline-flex items-center px-8 py-4 border border-[#1E1A15]/30 text-[#1E1A15] font-medium rounded-md hover:border-[#1E1A15]/60 hover:bg-[#1E1A15]/5 transition-colors duration-200 text-base"
          >
            {t(lang, 'quienesSomos.cta.btnAsesoria')}
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</BaseLayout>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    gsap.set(['.page-eyebrow', '.page-title', '.page-subtitle', '.page-logo'], { opacity: 0 });

    gsap.timeline({ defaults: { ease: 'power3.out' }, delay: 0.1 })
      .fromTo('.page-eyebrow', { y: 16, opacity: 0 }, { y: 0, opacity: 1, duration: 0.7 })
      .fromTo('.page-title',   { y: 40, opacity: 0 }, { y: 0, opacity: 1, duration: 0.9 }, '-=0.4')
      .fromTo('.page-subtitle',{ y: 24, opacity: 0 }, { y: 0, opacity: 1, duration: 0.7 }, '-=0.5')
      .fromTo('.page-logo',    { y: 16, opacity: 0 }, { y: 0, opacity: 1, duration: 0.6 }, '-=0.35');

    gsap.from('.story-title, .story-text', {
      y: 32, opacity: 0, duration: 0.8, stagger: 0.1, ease: 'power3.out',
      scrollTrigger: { trigger: '.story-title', start: 'top 85%', once: true },
    });

    gsap.from('.value-card', {
      y: 40, opacity: 0, duration: 0.7, stagger: 0.1, ease: 'power3.out',
      scrollTrigger: { trigger: '.values-section', start: 'top 82%', once: true },
    });

    gsap.from('.intro-section', {
      y: 40, opacity: 0, duration: 0.8, ease: 'power3.out',
      scrollTrigger: { trigger: '.intro-section', start: 'top 85%', once: true },
    });

    gsap.from('.trainer-section', {
      y: 40, opacity: 0, duration: 0.8, ease: 'power3.out',
      scrollTrigger: { trigger: '.trainer-section', start: 'top 82%', once: true },
    });

    gsap.from('.location-section', {
      y: 40, opacity: 0, duration: 0.8, ease: 'power3.out',
      scrollTrigger: { trigger: '.location-section', start: 'top 80%', once: true },
    });
  }
</script>
