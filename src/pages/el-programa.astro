---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { siteConfig } from '@/config/site';
import { getLang, t } from '@/i18n/utils';

const lang = getLang(Astro.currentLocale);

type OverviewItem = { value: string; label: string; desc: string };
type WorkshopItem = { number: string; date: string; title: string; desc: string; imgAlt: string; topics: string[] };
type MentoringItem = { title: string; desc: string };
type FaqItem = { q: string; a: string };
---

<BaseLayout
  title={t(lang, 'elPrograma.seo.title')}
  description={t(lang, 'elPrograma.seo.description')}
>
  <Header lang={lang} />

  <main>
    <!-- Page header -->
    <section class="pt-32 pb-16 bg-[#F0F2EE]">
      <div class="container max-w-3xl">
        <p class="page-eyebrow text-xs font-semibold uppercase tracking-[0.18em] text-[#6B8F71] mb-4">{t(lang, 'elPrograma.hero.eyebrow')}</p>
        <h1 class="page-title font-display text-4xl md:text-6xl text-[#1E1A15] leading-[1.05] mb-6" set:html={t(lang, 'elPrograma.hero.title')} />
        <p class="page-subtitle text-[#6B6355] text-xl leading-relaxed">
          {t(lang, 'elPrograma.hero.subtitle')}
        </p>
      </div>
    </section>

    <!-- VIDEO PRESENTACIÓN -->
    <section class="pt-12 pb-0 bg-[#FAFAF7]">
      <div class="container max-w-4xl">
        <div class="rounded-xl overflow-hidden shadow-lg bg-[#1E1A15]">
          <video
            class="w-full aspect-video object-cover"
            poster="/videos/programa-presentacion-poster.jpg"
            controls
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
          >
            <source src="/videos/programa-presentacion.mp4" type="video/mp4" />
          </video>
        </div>
      </div>
    </section>

    <!-- Formato -->
    <section class="py-20 bg-[#FAFAF7]">
      <div class="container max-w-5xl">
        <div class="grid md:grid-cols-3 gap-8 mb-20">
          {(t(lang, 'elPrograma.overview.items') as OverviewItem[]).map(item => (
            <div class="format-card text-center p-8 bg-white border border-[#DDD8CE] rounded-lg">
              <p class="font-display text-6xl text-[#8B1A1A] mb-2">{item.value}</p>
              <p class="font-semibold text-[#1E1A15] mb-3">{item.label}</p>
              <p class="text-sm text-[#6B6355] leading-relaxed">{item.desc}</p>
            </div>
          ))}
        </div>

        <!-- Talleres -->
        {(t(lang, 'elPrograma.workshops.items') as WorkshopItem[]).map((workshop, idx) => (
          <div class={`workshop-block mb-16 grid md:grid-cols-2 gap-12 items-start${idx === 1 ? ' flex-row-reverse' : ''}`}>
            {idx === 1 && (
              <img src={`/images/taller-${idx + 1}.jpg`} alt={workshop.imgAlt} class="rounded-lg w-full aspect-[4/3] object-cover shadow-md order-2 md:order-1" loading="lazy" />
            )}
            <div class={idx === 1 ? 'order-1 md:order-2' : ''}>
              <div class="flex items-center gap-4 mb-6">
                <span class="font-display text-6xl text-[#DDD8CE]">{workshop.number}</span>
                <div>
                  <p class="text-xs font-semibold uppercase tracking-wider text-[#C4622D]">{workshop.date}</p>
                  <h2 class="font-display text-2xl text-[#1E1A15]">{workshop.title}</h2>
                </div>
              </div>
              <p class="text-[#6B6355] leading-relaxed mb-6">{workshop.desc}</p>
              <h3 class="font-semibold text-[#1E1A15] mb-3 text-sm uppercase tracking-wide">{t(lang, 'elPrograma.workshops.topicsLabel')}</h3>
              <ul class="space-y-2">
                {workshop.topics.map(topic => (
                  <li class="flex gap-2.5 text-sm text-[#6B6355]">
                    <svg class="w-4 h-4 text-[#6B8F71] shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                    </svg>
                    {topic}
                  </li>
                ))}
              </ul>
            </div>
            {idx !== 1 && (
              <img src={`/images/taller-${idx + 1}.jpg`} alt={workshop.imgAlt} class="rounded-lg w-full aspect-[4/3] object-cover shadow-md" loading="lazy" />
            )}
          </div>
        ))}

        <p class="workshop-note text-sm text-[#6B6355] italic mb-20 -mt-8">{t(lang, 'elPrograma.workshops.note')}</p>

        <!-- Entre talleres -->
        <div class="between-section bg-[#F0F2EE] rounded-xl p-10 mb-20">
          <h2 class="font-display text-2xl text-[#1E1A15] mb-6">{t(lang, 'elPrograma.mentoring.title')}</h2>
          <div class="grid md:grid-cols-3 gap-8">
            {(t(lang, 'elPrograma.mentoring.items') as MentoringItem[]).map(item => (
              <div>
                <h3 class="font-semibold text-[#1E1A15] mb-2">{item.title}</h3>
                <p class="text-sm text-[#6B6355] leading-relaxed">{item.desc}</p>
              </div>
            ))}
          </div>
        </div>

      </div>
    </section>

    <!-- PRECIO / INVERSIÓN -->
    <section class="py-24 bg-[#1E1A15] text-[#FAFAF7]">
      <div class="container">
        <div class="max-w-3xl mx-auto text-center">
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-[#C4622D] mb-4">{t(lang, 'home.pricing.eyebrow')}</p>
          <h2 class="font-display text-3xl md:text-5xl mb-6 leading-tight">
            {t(lang, 'home.pricing.title')}
          </h2>
          <p class="text-[#FAFAF7]/70 text-lg mb-12 leading-relaxed">
            {t(lang, 'home.pricing.subtitle')}
          </p>

          <div class="pricing-card bg-[#FAFAF7]/5 border border-[#FAFAF7]/10 rounded-xl p-8 md:p-12 mb-8">
            <div class="flex flex-col md:flex-row items-center justify-center gap-8 mb-10">
              <div class="text-center">
                <p class="text-[#FAFAF7]/50 text-sm mb-1">{t(lang, 'home.pricing.payOnce')}</p>
                <p class="font-display text-5xl text-[#FAFAF7]">{siteConfig.program.price}<span class="text-2xl">€</span></p>
              </div>
              <div class="hidden md:block text-[#FAFAF7]/20 text-2xl">{t(lang, 'home.pricing.or')}</div>
              <div class="text-center">
                <p class="text-[#FAFAF7]/50 text-sm mb-1">{t(lang, 'home.pricing.payMonthly')}</p>
                <p class="font-display text-5xl text-[#FAFAF7]">{siteConfig.program.priceMonthly}<span class="text-2xl">€</span>
                  <span class="text-xl text-[#FAFAF7]/50">{t(lang, 'home.pricing.perMonth')}</span>
                </p>
                <p class="text-[#FAFAF7]/40 text-xs mt-1">{siteConfig.program.months} {t(lang, 'home.pricing.monthsLabel')} · {t(lang, 'home.pricing.reservaWith')} {siteConfig.program.deposit}€</p>
              </div>
            </div>

            <ul class="grid md:grid-cols-2 gap-3 text-sm text-[#FAFAF7]/70 mb-10 text-left">
              {(t(lang, 'home.pricing.includes') as string[]).map(item => (
                <li class="flex gap-2.5 items-start">
                  <svg class="w-4 h-4 text-[#6B8F71] shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                  </svg>
                  {item}
                </li>
              ))}
            </ul>

            <a
              href="/contacto"
              class="inline-flex items-center px-10 py-4 bg-[#8B1A1A] text-[#FAFAF7] font-semibold rounded-md hover:bg-[#6B1212] transition-colors duration-200 text-base"
            >
              {t(lang, 'home.pricing.ctaPre')}{siteConfig.program.spots}{t(lang, 'home.pricing.ctaPost')}
            </a>
            <p class="text-[#FAFAF7]/30 text-xs mt-4">{t(lang, 'home.pricing.startPrefix')} {siteConfig.program.startDate} · {siteConfig.program.location}</p>
          </div>

          <p class="text-[#FAFAF7]/40 text-sm">
            {t(lang, 'home.pricing.doubts')} <a href={`mailto:${siteConfig.contact.email}`} class="text-[#FAFAF7]/70 hover:text-[#FAFAF7] underline transition-colors">{siteConfig.contact.email}</a>
          </p>
        </div>
      </div>
    </section>

    <!-- BANNER: ONLINE / ASESORÍA -->
    <section class="py-20 bg-[#FAFAF7]">
      <div class="container max-w-5xl">
        <div class="grid md:grid-cols-2 gap-6">
          <div class="program-banner bg-[#6B8F71]/10 border border-[#6B8F71]/30 rounded-xl p-8 text-center">
            <h3 class="font-display text-xl text-[#1E1A15] mb-2">{t(lang, 'elPrograma.banner.online.title')}</h3>
            <p class="text-sm text-[#6B6355] mb-6">{t(lang, 'elPrograma.banner.online.desc')}</p>

            <form
              action="/api/waitlist"
              method="POST"
              id="programa-waitlist-form"
              class="flex flex-col sm:flex-row gap-3 max-w-sm mx-auto"
            >
              <label for="programa-waitlist-email" class="sr-only">{t(lang, 'elPrograma.banner.online.emailLabel')}</label>
              <input
                type="email"
                id="programa-waitlist-email"
                name="email"
                required
                autocomplete="email"
                class="flex-1 px-4 py-3 border border-[#DDD8CE] rounded-md bg-white text-[#1E1A15] placeholder-[#6B6355]/50 focus:outline-none focus:ring-2 focus:ring-[#6B8F71]/30 focus:border-[#6B8F71] transition-colors text-sm"
                placeholder={t(lang, 'elPrograma.banner.online.placeholder') as string}
              />
              <input type="hidden" name="tipo" value="waitlist-programa" />
              <input type="hidden" name="lang" value={lang} />
              <input type="text" name="_gotcha" class="hidden" tabindex="-1" autocomplete="off" />
              <button
                type="submit"
                id="programa-waitlist-submit"
                data-label-submit={t(lang, 'elPrograma.banner.online.cta')}
                data-label-sending={t(lang, 'elPrograma.banner.online.sending')}
                data-label-sent={t(lang, 'elPrograma.banner.online.sent')}
                class="px-6 py-3 bg-[#6B8F71] text-white font-semibold rounded-md hover:bg-[#587A5D] disabled:opacity-60 disabled:cursor-not-allowed transition-colors duration-200 text-sm whitespace-nowrap cursor-pointer"
              >
                {t(lang, 'elPrograma.banner.online.cta')}
              </button>
            </form>

            <p id="programa-waitlist-success" class="hidden mt-4 text-sm text-[#6B8F71] font-medium">
              {t(lang, 'elPrograma.banner.online.successMsg')}
            </p>
            <p id="programa-waitlist-error" class="hidden mt-4 text-sm text-[#8B1A1A] font-medium">
              {t(lang, 'elPrograma.banner.online.errorPrefix')} {siteConfig.contact.email}
            </p>
          </div>

          <div class="program-banner bg-white border border-[#DDD8CE] rounded-xl p-8 text-center flex flex-col justify-center items-center">
            <h3 class="font-display text-xl text-[#1E1A15] mb-2">{t(lang, 'elPrograma.banner.advisory.title')}</h3>
            <p class="text-sm text-[#6B6355] mb-6">{t(lang, 'elPrograma.banner.advisory.desc')}</p>
            <a
              href="/contacto"
              class="inline-flex items-center justify-center px-6 py-3 bg-[#1E1A15] text-white font-semibold rounded-md hover:bg-[#3A322A] transition-colors duration-200 text-sm"
            >
              {t(lang, 'elPrograma.banner.advisory.cta')}
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-20 bg-[#F0F2EE]">
      <div class="container max-w-3xl">
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-[#6B8F71] mb-4 text-center">{t(lang, 'elPrograma.faq.eyebrow')}</p>
        <h2 class="font-display text-3xl md:text-4xl text-[#1E1A15] mb-12 text-center">{t(lang, 'elPrograma.faq.title')}</h2>
        <div class="space-y-4">
          {(t(lang, 'elPrograma.faq.items') as FaqItem[]).map(item => (
            <div class="faq-item bg-white border border-[#DDD8CE] rounded-lg p-6">
              <h3 class="font-semibold text-[#1E1A15] mb-2">{item.q}</h3>
              <p class="text-sm text-[#6B6355] leading-relaxed">{item.a}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</BaseLayout>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    gsap.set(['.page-eyebrow', '.page-title', '.page-subtitle'], { opacity: 0 });

    gsap.timeline({ defaults: { ease: 'power3.out' }, delay: 0.1 })
      .fromTo('.page-eyebrow', { y: 16, opacity: 0 }, { y: 0, opacity: 1, duration: 0.7 })
      .fromTo('.page-title',   { y: 40, opacity: 0 }, { y: 0, opacity: 1, duration: 0.9 }, '-=0.4')
      .fromTo('.page-subtitle',{ y: 24, opacity: 0 }, { y: 0, opacity: 1, duration: 0.7 }, '-=0.5');

    gsap.from('.format-card', {
      y: 40, opacity: 0, duration: 0.7, stagger: 0.12, ease: 'power3.out',
      scrollTrigger: { trigger: '.format-card', start: 'top 82%', once: true },
    });

    gsap.utils.toArray('.workshop-block').forEach((block) => {
      gsap.from(block as Element, {
        y: 40, opacity: 0, duration: 0.8, ease: 'power3.out',
        scrollTrigger: { trigger: block as Element, start: 'top 80%', once: true },
      });
    });

    gsap.from('.between-section', {
      y: 40, opacity: 0, duration: 0.8, ease: 'power3.out',
      scrollTrigger: { trigger: '.between-section', start: 'top 82%', once: true },
    });

    gsap.fromTo('.pricing-card',
      { y: 48, opacity: 0 },
      { y: 0, opacity: 1, duration: 0.9, ease: 'power3.out',
        scrollTrigger: { trigger: '.pricing-card', start: 'top 80%', once: true } }
    );

    gsap.from('.program-banner', {
      y: 40, opacity: 0, duration: 0.7, stagger: 0.12, ease: 'power3.out',
      scrollTrigger: { trigger: '.program-banner', start: 'top 85%', once: true },
    });

    gsap.from('.faq-item', {
      y: 30, opacity: 0, duration: 0.6, stagger: 0.1, ease: 'power3.out',
      scrollTrigger: { trigger: '.faq-item', start: 'top 88%', once: true },
    });
  }

  // Waitlist form submission (edición online)
  const waitlistForm = document.getElementById('programa-waitlist-form') as HTMLFormElement | null;
  const waitlistSubmit = document.getElementById('programa-waitlist-submit') as HTMLButtonElement | null;
  const waitlistSuccess = document.getElementById('programa-waitlist-success');
  const waitlistError = document.getElementById('programa-waitlist-error');

  waitlistForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!waitlistSubmit || !waitlistForm) return;

    const labelSending = waitlistSubmit.dataset.labelSending ?? '...';
    const labelSent = waitlistSubmit.dataset.labelSent ?? '✓';
    const labelSubmit = waitlistSubmit.dataset.labelSubmit ?? waitlistSubmit.textContent ?? '';

    waitlistSubmit.disabled = true;
    waitlistSubmit.textContent = labelSending;
    waitlistSuccess?.classList.add('hidden');
    waitlistError?.classList.add('hidden');

    try {
      const res = await fetch(waitlistForm.action, {
        method: 'POST',
        body: new FormData(waitlistForm),
        headers: { Accept: 'application/json' },
      });

      if (!res.ok) throw new Error('request failed');

      waitlistSubmit.textContent = labelSent;
      waitlistForm.reset();
      waitlistSuccess?.classList.remove('hidden');
    } catch {
      waitlistSubmit.disabled = false;
      waitlistSubmit.textContent = labelSubmit;
      waitlistError?.classList.remove('hidden');
    }
  });
</script>
