---
import PanelLayout from '@/layouts/PanelLayout.astro';
import {
  FORM_TYPES,
  FORM_TYPE_LABELS,
  countByType,
  isConfigured,
  listLeads,
  paymentMethodLabel,
  type FormType,
} from '@/lib/leads';

export const prerender = false;

const tipoParam = Astro.url.searchParams.get('tipo');
const activeType: FormType | null =
  tipoParam && FORM_TYPES.includes(tipoParam as FormType) ? (tipoParam as FormType) : null;

const configured = isConfigured();

// Se traen todos los leads de una vez y se filtra en memoria: así las pestañas
// pueden mostrar el total de cada tipo sin una consulta por pestaña.
// listLeads ya devuelve vacío si Supabase no está configurado.
const { rows: allRows } = await listLeads();
const counts = countByType(allRows);
const rows = activeType ? allRows.filter((r) => r.form_type === activeType) : allRows;

const csvHref = activeType
  ? `/panel-suelos/api/export.csv?tipo=${activeType}`
  : '/panel-suelos/api/export.csv';

const dateFormatter = new Intl.DateTimeFormat('es-ES', {
  day: '2-digit',
  month: '2-digit',
  year: '2-digit',
  hour: '2-digit',
  minute: '2-digit',
});

const tabs = [
  { type: null as FormType | null, label: 'Todos', count: allRows.length },
  ...FORM_TYPES.map((type) => ({
    type: type as FormType | null,
    label: FORM_TYPE_LABELS[type],
    count: counts[type] ?? 0,
  })),
];

/** Junta en una sola celda los campos largos, que cambian según el formulario. */
function detalle(row: (typeof allRows)[number]) {
  return [
    row.message,
    row.servicio && `Servicio: ${row.servicio}`,
    row.finca && `Finca: ${row.finca}`,
    row.proyecto && `Proyecto: ${row.proyecto}`,
    row.dni && `Documento: ${row.dni}`,
    row.metodo_pago && `Pago: ${paymentMethodLabel(row.metodo_pago)}`,
    row.factura_nif && `Factura: ${[row.factura_nombre, row.factura_direccion, row.factura_nif].filter(Boolean).join(', ')}`,
  ]
    .filter(Boolean)
    .join(' · ');
}
---

<PanelLayout title="Leads">
  <main class="mx-auto max-w-6xl px-4 py-8">
    <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
      <div>
        <h1 class="text-2xl font-semibold">Leads recibidos</h1>
        <p class="text-sm text-[var(--color-text-muted)]">
          {rows.length} {rows.length === 1 ? 'registro' : 'registros'}
          {activeType ? ` en «${FORM_TYPE_LABELS[activeType]}»` : ' en total'}
        </p>
      </div>
      <a
        href={csvHref}
        class="rounded-md bg-[var(--color-primary)] px-4 py-2 text-sm font-medium text-[var(--color-text-inverse)] transition hover:bg-[var(--color-primary-dark)]"
      >
        ↓ Descargar CSV
      </a>
    </div>

    {!configured && (
      <p class="mb-6 rounded-md border border-amber-300 bg-amber-50 px-4 py-3 text-sm text-amber-800">
        Supabase no está configurado (faltan las variables de entorno
        <code>SUPABASE_URL</code> y <code>SUPABASE_SERVICE_ROLE_KEY</code>).
      </p>
    )}

    <nav class="mb-4 flex flex-wrap gap-2">
      {tabs.map((tab) => (
        <a
          href={tab.type ? `/panel-suelos?tipo=${tab.type}` : '/panel-suelos'}
          class:list={[
            'rounded-full border px-3 py-1.5 text-sm transition',
            tab.type === activeType
              ? 'border-[var(--color-primary)] bg-[var(--color-primary)] text-[var(--color-text-inverse)]'
              : 'border-[var(--color-border)] bg-[var(--color-bg)] text-[var(--color-text-muted)] hover:border-[var(--color-primary)]',
          ]}
        >
          {tab.label} <span class="opacity-70">({tab.count})</span>
        </a>
      ))}
    </nav>

    <div class="overflow-x-auto rounded-lg border border-[var(--color-border)] bg-[var(--color-bg)]">
      <table class="w-full min-w-[880px] text-left text-sm">
        <thead class="border-b border-[var(--color-border)] text-xs uppercase tracking-wide text-[var(--color-text-muted)]">
          <tr>
            <th class="px-4 py-3 font-medium">Fecha</th>
            <th class="px-4 py-3 font-medium">Tipo</th>
            <th class="px-4 py-3 font-medium">Nombre</th>
            <th class="px-4 py-3 font-medium">Email</th>
            <th class="px-4 py-3 font-medium">Teléfono</th>
            <th class="px-4 py-3 font-medium">Idioma</th>
            <th class="px-4 py-3 font-medium">Detalle</th>
          </tr>
        </thead>
        <tbody>
          {rows.length === 0 && (
            <tr>
              <td colspan="7" class="px-4 py-10 text-center text-[var(--color-text-muted)]">
                Todavía no hay leads en esta categoría.
              </td>
            </tr>
          )}
          {rows.map((row) => (
            <tr class="border-b border-[var(--color-border)] last:border-0 align-top">
              <td class="whitespace-nowrap px-4 py-3 text-[var(--color-text-muted)]">
                {dateFormatter.format(new Date(row.created_at))}
              </td>
              <td class="whitespace-nowrap px-4 py-3">
                {FORM_TYPE_LABELS[row.form_type as FormType] ?? row.form_type}
              </td>
              <td class="px-4 py-3">{row.name ?? '—'}</td>
              <td class="px-4 py-3">
                <a class="text-[var(--color-primary)] underline underline-offset-2" href={`mailto:${row.email}`}>
                  {row.email}
                </a>
              </td>
              <td class="whitespace-nowrap px-4 py-3">
                {row.phone ? (
                  <a class="text-[var(--color-primary)] underline underline-offset-2" href={`tel:${row.phone}`}>
                    {row.phone}
                  </a>
                ) : (
                  '—'
                )}
              </td>
              <td class="px-4 py-3 uppercase text-[var(--color-text-muted)]">{row.lang ?? '—'}</td>
              <td class="max-w-md px-4 py-3 text-[var(--color-text-muted)]">{detalle(row) || '—'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </main>
</PanelLayout>
