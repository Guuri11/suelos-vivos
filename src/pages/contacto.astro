---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { siteConfig } from '@/config/site';
import ConsentCheckbox from '@/components/ConsentCheckbox.astro';
import { getLang, localePath, t } from '@/i18n/utils';

const lang = getLang(Astro.currentLocale);
const lp = (path: string) => localePath(lang, path);

// Envío sin JavaScript: el endpoint devuelve aquí con el resultado en la query
// y el mensaje se pinta ya desde el servidor (ver src/lib/form-response.ts).
const sent = Astro.url.searchParams.get('enviado') === 'contacto';
const failed = Astro.url.searchParams.get('error') === 'contacto';
---

<BaseLayout
  title={t(lang, 'contacto.seo.title')}
  description={t(lang, 'contacto.seo.description')}
>
  <Header lang={lang} />

  <main>
    <section class="pt-32 pb-24 bg-[#FAFAF7]">
      <div class="container max-w-5xl">
        <div class="grid md:grid-cols-2 gap-16 items-start">

          <!-- Info lateral -->
          <div>
            <p class="page-eyebrow text-xs font-semibold uppercase tracking-[0.18em] text-[#6B8F71] mb-4">{t(lang, 'contacto.hero.eyebrow')}</p>
            <h1 class="page-title font-display text-4xl md:text-5xl text-[#1E1A15] leading-[1.05] mb-6">
              {t(lang, 'contacto.hero.title')}
            </h1>
            <p class="page-subtitle text-[#6B6355] text-lg leading-relaxed mb-10">
              {t(lang, 'contacto.hero.subtitle')}
            </p>

            <!-- La intención de reservar tiene su propia página; aquí solo se le señala. -->
            <a
              href={lp('/reserva-plaza')}
              class="reserva-card block rounded-xl border border-[#DDD8CE] bg-white p-6 mb-10 hover:border-[#8B1A1A] hover:shadow-sm transition-all duration-200 group"
            >
              <p class="font-display text-lg text-[#1E1A15] mb-1.5">{t(lang, 'contacto.reserva.prompt')}</p>
              <p class="text-sm text-[#6B6355] leading-relaxed mb-3">{t(lang, 'contacto.reserva.text')}</p>
              <span class="text-sm font-medium text-[#8B1A1A] group-hover:text-[#6B1212] transition-colors">
                {t(lang, 'contacto.reserva.link')} →
              </span>
            </a>

            <div class="pt-8 border-t border-[#DDD8CE]">
              <p class="text-sm text-[#6B6355] mb-2">{t(lang, 'contacto.info.directContact')}</p>
              <a href={`mailto:${siteConfig.contact.email}`} class="text-[#8B1A1A] hover:text-[#6B1212] font-medium transition-colors">
                {siteConfig.contact.email}
              </a>
            </div>
          </div>

          <!-- Formulario -->
          <div class="contact-form bg-white border border-[#DDD8CE] rounded-xl p-8 shadow-sm">
            <h2 class="font-display text-2xl text-[#1E1A15] mb-6">{t(lang, 'contacto.form.title')}</h2>

            <form
              action="/api/contact"
              method="POST"
              id="contact-form"
              class="space-y-5"
            >
              <div>
                <label for="name" class="block text-sm font-medium text-[#1E1A15] mb-1.5">{t(lang, 'contacto.form.nombreLabel')}</label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  autocomplete="name"
                  class="w-full px-4 py-3 border border-[#DDD8CE] rounded-md bg-[#FAFAF7] text-[#1E1A15] placeholder-[#6B6355]/50 focus:outline-none focus:ring-2 focus:ring-[#8B1A1A]/30 focus:border-[#8B1A1A] transition-colors text-sm"
                  placeholder={t(lang, 'contacto.form.nombrePlaceholder') as string}
                />
              </div>

              <div>
                <label for="email" class="block text-sm font-medium text-[#1E1A15] mb-1.5">{t(lang, 'contacto.form.emailLabel')}</label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  autocomplete="email"
                  class="w-full px-4 py-3 border border-[#DDD8CE] rounded-md bg-[#FAFAF7] text-[#1E1A15] placeholder-[#6B6355]/50 focus:outline-none focus:ring-2 focus:ring-[#8B1A1A]/30 focus:border-[#8B1A1A] transition-colors text-sm"
                  placeholder={t(lang, 'contacto.form.emailPlaceholder') as string}
                />
              </div>

              <div>
                <label for="phone" class="block text-sm font-medium text-[#1E1A15] mb-1.5">{t(lang, 'contacto.form.telefonoLabel')}</label>
                <input
                  type="tel"
                  id="phone"
                  name="phone"
                  required
                  autocomplete="tel"
                  class="w-full px-4 py-3 border border-[#DDD8CE] rounded-md bg-[#FAFAF7] text-[#1E1A15] placeholder-[#6B6355]/50 focus:outline-none focus:ring-2 focus:ring-[#8B1A1A]/30 focus:border-[#8B1A1A] transition-colors text-sm"
                  placeholder={t(lang, 'contacto.form.telefonoPlaceholder') as string}
                />
              </div>

              <div>
                <label for="message" class="block text-sm font-medium text-[#1E1A15] mb-1.5">{t(lang, 'contacto.form.mensajeLabel')}</label>
                <textarea
                  id="message"
                  name="message"
                  rows="5"
                  class="w-full px-4 py-3 border border-[#DDD8CE] rounded-md bg-[#FAFAF7] text-[#1E1A15] placeholder-[#6B6355]/50 focus:outline-none focus:ring-2 focus:ring-[#8B1A1A]/30 focus:border-[#8B1A1A] transition-colors text-sm resize-none"
                  placeholder={t(lang, 'contacto.form.mensajePlaceholder') as string}
                ></textarea>
              </div>

              <ConsentCheckbox lang={lang} id="contacto-privacy" />

              <input type="hidden" name="tipo" value="contacto" />
              <input type="hidden" name="lang" value={lang} />

              <!-- Honeypot -->
              <input type="text" name="_gotcha" class="hidden" tabindex="-1" autocomplete="off" />

              <button
                type="submit"
                id="submit-btn"
                data-label-submit={t(lang, 'contacto.form.submit')}
                data-label-sending={t(lang, 'contacto.form.sending')}
                data-label-sent={t(lang, 'contacto.form.sent')}
                class="w-full px-6 py-3.5 bg-[#8B1A1A] text-[#FAFAF7] font-semibold rounded-md hover:bg-[#6B1212] disabled:opacity-60 disabled:cursor-not-allowed transition-colors duration-200 text-sm cursor-pointer"
              >
                {t(lang, 'contacto.form.submit')}
              </button>

              <p id="form-success" class:list={['text-sm text-[#6B8F71] text-center font-medium p-3 bg-[#6B8F71]/10 rounded-md', !sent && 'hidden']}>
                {t(lang, 'contacto.form.successMsg')}
              </p>
              <p id="form-error" class:list={['text-sm text-[#8B1A1A] text-center font-medium p-3 bg-[#8B1A1A]/10 rounded-md', !failed && 'hidden']}>
                {t(lang, 'contacto.form.errorPrefix')} {siteConfig.contact.email}
              </p>
            </form>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</BaseLayout>

<script>
  import { gsap } from 'gsap';
  import { trackLead } from '@/lib/consent';

  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    gsap.set(['.page-eyebrow', '.page-title', '.page-subtitle'], { opacity: 0 });
    gsap.timeline({ defaults: { ease: 'power3.out' }, delay: 0.1 })
      .fromTo('.page-eyebrow', { y: 16, opacity: 0 }, { y: 0, opacity: 1, duration: 0.7 })
      .fromTo('.page-title',   { y: 40, opacity: 0 }, { y: 0, opacity: 1, duration: 0.9 }, '-=0.4')
      .fromTo('.page-subtitle',{ y: 24, opacity: 0 }, { y: 0, opacity: 1, duration: 0.7 }, '-=0.5')
      .fromTo('.contact-form', { y: 40, opacity: 0 }, { y: 0, opacity: 1, duration: 0.8 }, '-=0.6');
  }

  // Form submission
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
  const successMsg = document.getElementById('form-success');
  const errorMsg = document.getElementById('form-error');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!submitBtn || !form) return;

    const labelSending = submitBtn.dataset.labelSending ?? '...';
    const labelSent = submitBtn.dataset.labelSent ?? '✓';
    const labelSubmit = submitBtn.dataset.labelSubmit ?? submitBtn.textContent ?? '';

    submitBtn.disabled = true;
    submitBtn.textContent = labelSending;

    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });

      if (res.ok) {
        form.reset();
        trackLead('contacto');
        successMsg?.classList.remove('hidden');
        errorMsg?.classList.add('hidden');
        submitBtn.textContent = labelSent;
      } else {
        throw new Error('Server error');
      }
    } catch {
      errorMsg?.classList.remove('hidden');
      successMsg?.classList.add('hidden');
      submitBtn.disabled = false;
      submitBtn.textContent = labelSubmit;
    }
  });
</script>
